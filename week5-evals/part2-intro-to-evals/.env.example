# Copy to .env. Only needed for Live mode. Any OpenAI-compatible endpoint works.
EVAL_MODE=live
OPENAI_API_KEY=your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# The ladder, cheapest first. Prices are in evals/models.py: update them.
SMALL_MODEL=gpt-4.1-nano
MEDIUM_MODEL=gpt-4.1-mini
LARGE_MODEL=gpt-4.1
# The judge should not be a model whose answers it grades.
JUDGE_MODEL=gpt-4.1

# OpenRouter example (step 7's Batch API is OpenAI-only):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# SMALL_MODEL=openai/gpt-4.1-nano
