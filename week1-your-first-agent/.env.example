# Copy to .env. Only needed for Live mode. Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=your-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
SEARCH_MODEL=gpt-4o-mini-search-preview   # a model with built-in web search (step 7)

# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL=openai/gpt-4o-mini
# SEARCH_MODEL=openai/gpt-4o-mini:online
